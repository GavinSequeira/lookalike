# Copy to server/.env (never commit .env). Paste your Atlas URI as-is.
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=lookalike
PORT=5000
SESSION_SECRET=change-me-to-a-long-random-string

# Extra allowed frontend origins (comma separated). localhost:5173 is always allowed.
FRONTEND_URL=https://lookalike-frontend.onrender.com

# Emails allowed to use the file tools on /manage (feedback export, backups, delete).
ADMIN_EMAILS=
